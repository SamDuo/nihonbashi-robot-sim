data/network/raw_overpass_cache.json
outputs/reports/provenance.jsonl
outputs/reports/cooling_gap_residuals.csv
outputs/reports/testbed_comparison.md
# Local cache (OSM tiles, Mesa, etc.)
cache/
# TerriaJS catalog is regenerated by scripts/start_terriajs_demo.py; not committed
outputs/terriajs/
# Cesium diagnostic page (kept local only)
outputs/cesium_test.html
